prologue HTMLElement()
%{
#include <utils/corestrings.h>
#include "html/box.h"

/* an element's offset parent (the nearest positioned ancestor, table cell
 * or table, else the body): NULL when it has none (not rendered, fixed, the
 * body or the root); a new reference
 */
static dom_node *html_element_offset_parent(dom_node *node)
{
	int x, y, w, h;
	struct box *box;
	dom_node *n = NULL, *next;
	dom_string *name;

	if (!qjsky_node_box(node, &x, &y, &w, &h, &box) || box->style == NULL ||
	    css_computed_position(box->style) == CSS_POSITION_FIXED) {
		return NULL;
	}
	if (dom_node_get_node_name(node, &name) == DOM_NO_ERR && name != NULL) {
		bool root = dom_string_caseless_lwc_isequal(name, corestring_lwc_body) ||
			dom_string_caseless_lwc_isequal(name, corestring_lwc_html);
		dom_string_unref(name);
		if (root) {
			return NULL;
		}
	}
	if (dom_node_get_parent_node(node, &n) != DOM_NO_ERR) {
		return NULL;
	}
	while (n != NULL) {
		dom_node_type type;
		bool found = false;
		if (dom_node_get_node_type(n, &type) != DOM_NO_ERR || type != DOM_ELEMENT_NODE) {
			dom_node_unref(n);
			return NULL;
		}
		if (dom_node_get_node_name(n, &name) == DOM_NO_ERR && name != NULL) {
			found = dom_string_caseless_lwc_isequal(name, corestring_lwc_body) ||
				dom_string_caseless_lwc_isequal(name, corestring_lwc_td) ||
				dom_string_caseless_lwc_isequal(name, corestring_lwc_th) ||
				dom_string_caseless_lwc_isequal(name, corestring_lwc_table);
			dom_string_unref(name);
		}
		if (!found && qjsky_node_box(n, &x, &y, &w, &h, &box) && box->style != NULL &&
		    css_computed_position(box->style) != CSS_POSITION_STATIC) {
			found = true;
		}
		if (found) {
			return n;
		}
		next = NULL;
		dom_node_get_parent_node(n, &next);
		dom_node_unref(n);
		n = next;
	}
	return NULL;
}

/* an element's border box relative to its offset parent's padding edge
 * (the document's origin for the body or none)
 */
static void html_element_offset(dom_node *node, int *x, int *y)
{
	int w, h, px, py, pw, ph;
	struct box *pbox;
	dom_node *parent;
	dom_string *name;

	*x = *y = 0;
	if (!qjsky_node_box(node, x, y, &w, &h, NULL)) {
		return;
	}
	parent = html_element_offset_parent(node);
	if (parent == NULL) {
		return;
	}
	if (dom_node_get_node_name(parent, &name) == DOM_NO_ERR && name != NULL) {
		bool body = dom_string_caseless_lwc_isequal(name, corestring_lwc_body);
		dom_string_unref(name);
		if (!body && qjsky_node_box(parent, &px, &py, &pw, &ph, &pbox)) {
			*x -= px + pbox->border[LEFT].width;
			*y -= py + pbox->border[TOP].width;
		}
	}
	dom_node_unref(parent);
}
%}


getter HTMLElement::style()
%{
	/* a CSSStyleDeclaration over the style attribute (style.js), one
	 * per element
	 */
	JSValue style = qjsky_get_hidden(ctx, this_val, QJSKY_HIDDEN_STYLE);

	(void)priv;
	if (!JS_IsUndefined(style)) {
		return style;
	}
	style = qjsky_style_declaration(ctx, this_val);
	if (JS_IsException(style) ||
	    qjsky_set_hidden(ctx, this_val, QJSKY_HIDDEN_STYLE,
			     JS_DupValue(ctx, style)) < 0) {
		JS_FreeValue(ctx, style);
		return JS_EXCEPTION;
	}
	return style;
%}

/* CSSOM View: the layout's offsets */

getter HTMLElement::offsetParent()
%{
	dom_node *parent = html_element_offset_parent(((node_private_t *)priv)->node);
	JSValue ret = qjsky_node(ctx, parent);
	if (parent != NULL) {
		dom_node_unref(parent);
	}
	return ret;
%}

getter HTMLElement::offsetTop()
%{
	int x, y;
	html_element_offset(((node_private_t *)priv)->node, &x, &y);
	return JS_NewInt32(ctx, y);
%}

getter HTMLElement::offsetLeft()
%{
	int x, y;
	html_element_offset(((node_private_t *)priv)->node, &x, &y);
	return JS_NewInt32(ctx, x);
%}

getter HTMLElement::offsetWidth()
%{
	int x, y, w = 0, h = 0;
	if (!qjsky_node_box(((node_private_t *)priv)->node, &x, &y, &w, &h, NULL)) {
		w = 0;
	}
	return JS_NewInt32(ctx, w);
%}

getter HTMLElement::offsetHeight()
%{
	int x, y, w = 0, h = 0;
	if (!qjsky_node_box(((node_private_t *)priv)->node, &x, &y, &w, &h, NULL)) {
		h = 0;
	}
	return JS_NewInt32(ctx, h);
%}
